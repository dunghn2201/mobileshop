rules:
  - name: firestore.rules
    service: cloud.firestore
    rules_version: '2'
    
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: anyone can read, only admins write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categories: anyone can read, only admins write
    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: anyone can create, only admins can read/update all
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }

    // Bookings: anyone can create, only admins can read/update all
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }

    // Users: owner can read/write own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
